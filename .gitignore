# Secrets and Environment Variables
.env
.env.*
*.key
*.pem
*.cert
secrets/
credentials.json

# LaTeX Build Artifacts
*.aux
*.log
*.out
*.toc
*.lof
*.lot
*.fls
*.fdb_latexmk
*.synctex.gz
*.bbl
*.bcf
*.blg
*.run.xml
*-blx.bib
*-SAVE-ERROR
*.dvi
*.nav
*.snm
*.vrb

# PDFs — ignore all except committed documents
*.pdf
!content/prestudy/main.pdf
!content/thesis/main.pdf
!content/resources/**/*.pdf
!content/archive/**/*.pdf

# Section build artifacts
sections/*.pdf
sections/*.log
sections/*.aux
sections/*.out
sections/*.fdb_latexmk
sections/*.fls
sections/*.synctex.gz
sections/*.bbl
sections/*.bcf
sections/*.blg
content/*/sections/*.pdf
content/*/sections/*.synctex.gz

# Generated build artifacts
content/resources/bibliography_bibertool.bib
content/resources/bibliography.bib.blg
content/resources/tables/table_*.tex

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
.pytest_cache/
.coverage
.ruff_cache/
htmlcov/
*.cover

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# IDE
.vscode/
.idea/
*.swp
.claude/

# Word lock files
~$*.docx

# Temporary test/audit files
.automaker/
webapp/*AUDIT.md
webapp/*-audit.js

# Node.js / Electron
node_modules/
out/
dist/
coverage/

# Working documents (plans, research, audits — kebab-case convention)
**/*-plan*.md
**/*-research*.md
**/*-audit*.md
**/plan-*.md
**/research-*.md
**/audit-*.md

# Local Netlify folder
.netlify
